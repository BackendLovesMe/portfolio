# Supabase project settings (server-side only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Admin dashboard password: use a long, unique password
ADMIN_DASHBOARD_PASSWORD=replace_with_a_long_unique_password
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters

# Optional visitor email alerts via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PORTFOLIO_ALERT_EMAIL=
SITE_URL=http://localhost:3000
